  - _image: {fileID: 21300000, guid: f82017e8597544c0a99b2d06ceed4a93, type: 3}
    _text: "\u0420\u0430\u0437\u043D\u044B\u0435 \u0444\u0440\u0443\u043A\u0442\u044B
      \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0442 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u0418\u0441\u043A\u0440\u044B. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435
      \u0444\u0440\u0443\u043A\u0442 \u0438\u0437 \u044F\u0449\u0438\u043A\u0430
      \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u0435 \u0435\u0433\u043E
      \u0418\u0441\u043A\u0440\u0435."
  - _image: {fileID: 21300000, guid: 587237320d7e4d25aec590700feb4608, type: 3}
    _text: "\u0421\u0432\u0435\u0442\u044F\u0449\u0438\u0435\u0441\u044F \u0442\u043E\u0447\u043A\u0438
      \u0432\u0435\u0434\u0443\u0442 \u043A \u0442\u0435\u043A\u0443\u0449\u0435\u0439
      \u0446\u0435\u043B\u0438. \u0417\u0430\u0435\u0437\u0436\u0430\u0439\u0442\u0435
      \u0432 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u0443\u044E \u0437\u043E\u043D\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0438\u043B\u0438
      \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0433\u0440\u0443\u0437."
  - _image: {fileID: 21300000, guid: c570c572932e49e698277f61876a9e90, type: 3}
    _text: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0441 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u043C
      TERRARIUM \u0432\u0435\u0434\u0435\u0442 \u0434\u043E\u043C\u043E\u0439. \u041F\u0440\u0438
      \u0434\u043E\u0441\u0440\u043E\u0447\u043D\u043E\u043C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u0437\u0430 \u043F\u043E\u0435\u0437\u0434\u043A\u0443
      \u043F\u0440\u043E\u043F\u0430\u0434\u0443\u0442."
