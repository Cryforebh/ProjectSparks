  m_Script: {fileID: 11500000, guid: 730d5bf3c59b4476926261be7b2c43ad, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _intro: {fileID: 100026}
  _stepPanel: {fileID: 100034}
  _title: {fileID: 100021}
  _status: {fileID: 100017}
  _description: {fileID: 100047}
  _image: {fileID: 100043}
  _backButton: {fileID: 100065}
  _nextButton: {fileID: 100074}
  _nextLabel: {fileID: 100078}
  _skipButton: {fileID: 100056}
  _steps:
  - _title: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0418\u0441\u043A\u0440\u0443
      \u043D\u0430 \u0440\u0443\u043A\u0438"
    _description: "\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u0418\u0441\u043A\u0440\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      E. \u041A\u043E\u0433\u0434\u0430 \u0418\u0441\u043A\u0440\u0430 \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0443 \u0432\u0430\u0441 \u0432 \u0440\u0443\u043A\u0430\u0445, \u0441\u043B\u0435\u0432\u0430
      \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F \u0435\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438."
    _image: {fileID: 21300000, guid: a698f81d0cc14af0ae80a74a6789c7cb, type: 3}
  - _title: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0441\u0442\u043E\u043B\u0443"
    _description: "\u0421 \u0418\u0441\u043A\u0440\u043E\u0439 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u043F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0441\u0442\u043E\u043B\u0443
      \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.
      \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u0441\u0442\u043E\u043B
      \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 E, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u044C \u0435\u0435."
    _image: {fileID: 21300000, guid: 0cc7f69510c743248251310a22ef66ca, type: 3}
  - _title: "\u0414\u0430\u0439\u0442\u0435 \u0418\u0441\u043A\u0440\u0435 \u0438\u043C\u044F"
    _description: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u043E\u0432\u043E\u0435
      \u0438\u043C\u044F \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C\xBB.
      \u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435,
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0412\u0437\u044F\u0442\u044C
      \u0432 \u0440\u0443\u043A\u0438\xBB."
    _image: {fileID: 21300000, guid: 5de79f43a22e40639ec6958cc16aca86, type: 3}
  - _title: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u044F\u0449\u0438\u043A
      \u0441 \u0444\u0440\u0443\u043A\u0442\u0430\u043C\u0438"
    _description: "\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u043E\u0440\u043C\u0438\u0442\u044C
      \u0418\u0441\u043A\u0440\u0443, \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0444\u0440\u0443\u043A\u0442.
      \u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u044F\u0449\u0438\u043A\u0443,
      \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u043D\u0435\u0433\u043E
      \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 E."
    _image: {fileID: 21300000, guid: 9b1d0660741646139a783ebdcd527b99, type: 3}
  - _title: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0440\u0443\u043A\u0442"
    _description: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0444\u0440\u0443\u043A\u0442
      \u0432 \u044F\u0449\u0438\u043A\u0435, \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C
      \u0435\u0433\u043E \u0432 \u0440\u0443\u043A\u0438. \u0420\u0430\u0437\u043D\u044B\u0435
      \u0444\u0440\u0443\u043A\u0442\u044B \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0442
      \u0440\u0430\u0437\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u0418\u0441\u043A\u0440\u044B."
    _image: {fileID: 21300000, guid: f82017e8597544c0a99b2d06ceed4a93, type: 3}
  - _title: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u0435 \u0444\u0440\u0443\u043A\u0442
      \u0418\u0441\u043A\u0440\u0435"
    _description: "\u0421 \u0444\u0440\u0443\u043A\u0442\u043E\u043C \u0432 \u0440\u0443\u043A\u0430\u0445
      \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u0418\u0441\u043A\u0440\u0443
      \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 E. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435,
      \u043A\u0430\u043A \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u0441\u044F \u0435\u0435
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438,
      \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041F\u043E\u043A\u043E\u0440\u043C\u0438\u0442\u044C\xBB."
    _image: {fileID: 21300000, guid: e10b3597189e4e7bac179503bcbd07b3, type: 3}
  - _title: "\u0414\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u043A\u043E\u043D\u0446\u0430
      \u043A\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F"
    _description: "\u0414\u0430\u0439\u0442\u0435 \u0418\u0441\u043A\u0440\u0435
      \u0432\u0440\u0435\u043C\u044F \u0441\u044A\u0435\u0441\u0442\u044C \u0444\u0440\u0443\u043A\u0442.
      \u0415\u0441\u043B\u0438 \u0432\u0437\u044F\u0442\u044C \u0435\u0435 \u043D\u0430
      \u0440\u0443\u043A\u0438 \u0440\u0430\u043D\u044C\u0448\u0435, \u043A\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435
      \u043F\u0440\u0435\u0440\u0432\u0435\u0442\u0441\u044F \u0438 \u0444\u0440\u0443\u043A\u0442
      \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u043D\u0435\u0441\u044A\u0435\u0434\u0435\u043D\u043D\u044B\u043C."
    _image: {fileID: 21300000, guid: ca5c735d39a84d639a99f740411195f3, type: 3}
  - _title: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0434\u0432\u0435\u0440\u0438"
    _description: "\u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u0445\u043E\u0442\u0438\u0442\u0435
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0443, \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0434\u0432\u0435\u0440\u044C \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      E."
    _image: {fileID: 21300000, guid: f0f2b5d5109743d1bd0c40cf357c642c, type: 3}
  - _title: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    _description: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \xAB\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F\xBB.
      \u041F\u0435\u0440\u0435\u0434 \u0432\u044B\u0435\u0437\u0434\u043E\u043C \u0438\u0433\u0440\u0430
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u0418\u0441\u043A\u0440\u0443 \u0432 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0438."
    _image: {fileID: 21300000, guid: 243f6b1d675341c58370f9559aa4370e, type: 3}
  - _title: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0431\u043E\u043D\u0443\u0441\u044B
      \u0418\u0441\u043A\u0440\u044B"
    _description: "\u041F\u0440\u0438 \u0432\u044B\u0431\u043E\u0440\u0435 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u043A\u0430\u043A\u0438\u0435
      \u0431\u043E\u043D\u0443\u0441\u044B \u043E\u043D \u0434\u0430\u0441\u0442
      \u043D\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0435. \u0411\u043E\u043D\u0443\u0441\u044B
      \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A
      \u0418\u0441\u043A\u0440\u044B."
    _image: {fileID: 21300000, guid: 269d7af613ae405a94029e38f8a5ece3, type: 3}
  - _title: "\u0417\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0433\u0440\u0443\u0437"
    _description: "\u0421\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u0437\u0430
      \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u043C\u0438\u0441\u044F \u0442\u043E\u0447\u043A\u0430\u043C\u0438
      \u0434\u043E \u0441\u043A\u043B\u0430\u0434\u0430. \u0417\u0430\u0435\u0437\u0436\u0430\u0439\u0442\u0435
      \u0432 \u0437\u043E\u043D\u0443 \u043F\u043E\u0434 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0433\u0440\u0443\u0437."
    _image: {fileID: 21300000, guid: 587237320d7e4d25aec590700feb4608, type: 3}
  - _title: "\u0414\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0433\u0440\u0443\u0437"
    _description: "\u041E\u0442\u0432\u0435\u0437\u0438\u0442\u0435 \u0433\u0440\u0443\u0437
      \u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044E. \u0417\u0430
      \u043A\u0430\u0436\u0434\u0443\u044E \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0443
      \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F \u043C\u043E\u043D\u0435\u0442\u044B.
      \u0412 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u0438\u0445 \u043C\u043E\u0436\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043D\u0430
      \u0444\u0440\u0443\u043A\u0442\u044B \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B."
    _image: {fileID: 21300000, guid: 4e8bc004acc54475ae0a3c4ecf7bfd70, type: 3}
  - _title: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0432 \u0422\u0435\u0440\u0440\u0430\u0440\u0438\u0443\u043C"
    _description: "\u041F\u043E \u043F\u0443\u0442\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435
      \u0444\u0440\u0443\u043A\u0442\u044B. \u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435
      \u0441 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u043C \xABTERRARIUM\xBB.
      \u041F\u0440\u0438 \u0434\u043E\u0441\u0440\u043E\u0447\u043D\u043E\u043C \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u0444\u0440\u0443\u043A\u0442\u044B
      \u0437\u0430 \u044D\u0442\u0443 \u043F\u043E\u0435\u0437\u0434\u043A\u0443
      \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B."
    _image: {fileID: 21300000, guid: c570c572932e49e698277f61876a9e90, type: 3}
