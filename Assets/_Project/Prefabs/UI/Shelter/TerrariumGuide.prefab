--- !u!114 &100033
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C
    \u0418\u0441\u043A\u0440\u0443 \u043D\u0430 \u0440\u0443\u043A\u0438, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u0435\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438,
    \u0434\u0430\u0442\u044C \u0435\u0439 \u0438\u043C\u044F \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
    \u0438 \u043F\u043E\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u0444\u0440\u0443\u043A\u0442\u0430\u043C\u0438
    \u0438\u0437 \u044F\u0449\u0438\u043A\u0430.\n\n\u041A\u043E\u0433\u0434\u0430
    \u0431\u0443\u0434\u0435\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u044B \u043A
    \u043F\u043E\u0435\u0437\u0434\u043A\u0435, \u0443 \u0434\u0432\u0435\u0440\u0438
    \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442
    \u0438 \u0418\u0441\u043A\u0440\u0443-\u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430.
    \u0415\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u0432\u0430\u043C \u043D\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0435.\n\n\u0427\u0442\u043E\u0431\u044B
